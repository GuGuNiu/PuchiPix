    /**
     * 切换收藏状态
     */
    async toggleFavorite() {
      try {
        var action = this.isFavorite ? 'remove' : 'add';
        var response = await fetch('/web-api/v1/favorite', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ galleryId: parseInt(this.galleryId), action: action })
        });
        var result = await response.json();
        if (result.success) {
          this.isFavorite = !this.isFavorite;
          showToast(this.isFavorite ? '已收藏' : '已取消收藏', 'success');
        } else {
          showToast(result.message || '操作失败', 'error');
        }
      } catch (error) {
        showToast('操作失败，请重试', 'error');
      }
    },

    /**
     * 打开分享弹窗
     */
    openShare() {
      openShareModal({
        title: cfg.shareTitle || '',
        url: '/latp/' + this.galleryId + '.html',
        imageCount: cfg.imageCount || 0,
        categoryName: cfg.categoryName || '',
        inviteCode: cfg.inviteCode || ''
      });
    }
  };
}

