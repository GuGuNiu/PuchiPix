function latpPage() {
  var cfg = window.__latpConfig || {};
  return {
    galleryId: cfg.galleryId || '',
    viewMode: 'grid',
    isPurchased: cfg.isPurchase || false,
    isPurchasedVideo: cfg.isBuyVideo || false,
    isPurchasedDownload: cfg.isPurchaseDownload || false,
    isUnlocking: false,
    isFavorite: cfg.isFavorite || false,
    canUseVipForGallery: cfg.canUseVipForGallery || false,
    canUseVipForVideo: cfg.canUseVipForVideo || false,
    canUseVipForDownload: cfg.canUseVipForDownload || false,
    canUseVipForCategory: cfg.canUseVipForCategory || false,
    previewCount: cfg.previewCount || 2,
    userPoints: cfg.userPoints || 0,

    /**
     * 构建 sessionStorage 滚动位置键名
     */
    buildScrollKey() {
      return 'latp_unlock_scroll_' + this.galleryId;
    },

    /**
     * 保存当前滚动位置到 sessionStorage
     */
    saveScrollPosition() {
      sessionStorage.setItem(this.buildScrollKey(), window.scrollY);
    },

    /**
     * 恢复并清理 sessionStorage 中保存的滚动位置
     */
    restoreScrollPosition() {
      var scrollKey = this.buildScrollKey();
      var savedScrollY = sessionStorage.getItem(scrollKey);
      if (savedScrollY) {
        sessionStorage.removeItem(scrollKey);
        requestAnimationFrame(function() {
          window.scrollTo({ top: parseInt(savedScrollY, 10), behavior: 'instant' });
        });
      }
    },

    init() {
      // 自动解锁提示
      if (cfg.autoUnlocked) {
        setTimeout(function() {
          showToast('尊贵的会员，已根据您的权益自动解锁本图集', 'success', 3000);
        }, 800);
      }
      // 恢复解锁后的滚动位置
      this.restoreScrollPosition();

      // 初始化 Fancybox 5 图片灯箱
      if (typeof Fancybox !== 'undefined') {
        var self = this;
        var isMobile = window.matchMedia('(max-width: 768px)').matches;
        var toolbarDisplay = {
          left: ['infobar'],
          middle: isMobile ? [] : ['zoomIn', 'zoomOut', 'toggle1to1', 'rotateCCW', 'rotateCW', 'flipX', 'flipY'],
          right: ['slideshow', 'thumbs', 'fullscreen', 'close'],
        };
        var fancyboxOptions = {
          Toolbar: {
            display: toolbarDisplay,
          },
          Thumbs: { autoStart: false },
          animated: true,
          Slideshow: {
            playOnStart: false,
            timeout: 3000,
          },
          Images: {
            zoom: true,
            click: 'toggleZoom',
            wheel: 'zoom',
            Panzoom: {
              maxScale: 4,
              pinchToZoom: true,
            },
          },
          Carousel: {
            friction: 0.88,
            infinite: true,
          },
          showClass: 'f-zoomInUp',
          hideClass: 'f-zoomOutDown',
          on: {
            ready: function() {
              setTimeout(function() { self.addFancyboxDownloadButton(); }, 50);
            },
            'Carousel.ready': function(fancybox) {
              if ('ontouchstart' in window) {
                var pressTimer = null;
                var container = fancybox.$container;

                container.addEventListener('touchstart', function(e) {
                  pressTimer = setTimeout(function() {
                    self.showImageContextMenu(fancybox, e);
                  }, 600);
                }, { passive: true });

                container.addEventListener('touchend', function() {
                  clearTimeout(pressTimer);
                }, { passive: true });

                container.addEventListener('touchmove', function() {
                  clearTimeout(pressTimer);
                }, { passive: true });
              }
            },
          },
          l10n: {
            CLOSE: '关闭',
            NEXT: '下一张',
            PREV: '上一张',
            MODAL: '您可以使用键盘关闭此模态框',
            ERROR: '加载失败，请稍后重试',
            IMAGE_ERROR: '图片未找到',
            ELEMENT_NOT_FOUND: '未找到 HTML 元素',
            AJAX_NOT_FOUND: '加载 AJAX 失败：未找到',
            AJAX_FORBIDDEN: '加载 AJAX 失败：禁止访问',
            IFRAME_ERROR: '加载页面失败',
            TOGGLE_ZOOM: '切换缩放级别',
            TOGGLE_THUMBS: '切换缩略图',
            TOGGLE_SLIDESHOW: '开始/停止自动播放',
            TOGGLE_FULLSCREEN: '全屏',
            DOWNLOAD: '保存图片',
          },
        };

        if (isMobile) {
          fancyboxOptions.caption = false;
        }

        Fancybox.bind('[data-fancybox="gallery"]', fancyboxOptions);
      }
    },

    /**
     * 添加自定义下载按钮到 Fancybox 工具栏
     */
    addFancyboxDownloadButton() {
      var toolbar = document.querySelector('.f-carousel__toolbar .is-right');
      if (!toolbar) {
        var fancyboxToolbar = document.querySelector('.fancybox__toolbar');
        if (fancyboxToolbar) {
          toolbar = fancyboxToolbar.querySelector('.fancybox__toolbar__column.is-right') ||
                    fancyboxToolbar.querySelector('.fancybox__toolbar__column:last-child');
        }
      }
      if (!toolbar) return;

      if (toolbar.querySelector('[data-download-btn]')) return;
      if (document.querySelector('[data-download-btn]')) return;

      var downloadSvg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/><polyline points="7 11 12 16 17 11"/><line x1="12" y1="16" x2="12" y2="4"/></svg>';

      var btn = document.createElement('button');
      var self = this;
      btn.className = 'f-button';
      btn.setAttribute('title', '保存图片');
      btn.setAttribute('data-download-btn', 'true');
      btn.innerHTML = downloadSvg;

      btn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        var instance = Fancybox.getInstance();
        if (instance) {
          var slide = instance.getSlide();
          if (slide && slide.src && typeof slide.src === 'string') {
            self.downloadImage(slide.src);
          }
        }
      });

      toolbar.insertBefore(btn, toolbar.firstChild);
    },

    /**
     * 下载图片（支持跨域 CDN 图片）
     */
    async downloadImage(url, filename) {
      try {
        var defaultFilename = url.split('/').pop()?.split('?')[0] || 'image.jpg';
        var finalFilename = filename || defaultFilename;

        var response = await fetch(url, { mode: 'cors' });
        if (!response.ok) throw new Error('下载失败');

        var blob = await response.blob();
        var blobUrl = URL.createObjectURL(blob);

        var link = document.createElement('a');
        link.href = blobUrl;
        link.download = finalFilename;
        link.style.display = 'none';
        document.body.appendChild(link);
        link.click();

        setTimeout(function() {
          document.body.removeChild(link);
          URL.revokeObjectURL(blobUrl);
        }, 100);

        showToast('图片已保存', 'success');
      } catch (error) {
        window.open(url, '_blank');
        showToast('已在新标签页打开图片，请手动保存', 'info');
      }
    },

    /**
     * 显示图片操作菜单（移动端长按触发）
     */
    showImageContextMenu(fancybox, event) {
      var slide = fancybox.getSlide();
      if (!slide || !slide.src) return;
      showToast('长按图片可保存到相册', 'info', 2000);
    },

    /**
     * 保存图片（触发浏览器下载）
     */
    saveImage(url) {
      this.downloadImage(url);
    },

    /**
     * 设置图集视图模式并保存用户偏好
     */
    setViewMode(mode) {
      this.viewMode = mode;
      localStorage.setItem('gallery_view_mode', mode);
    },

    /**
     * 从服务器获取最新积分并更新本地缓存
     */
    async refreshUserPoints() {
      try {
        var response = await fetch('/web-api/v1/user/points');
        var result = await response.json();
        if (result.success && typeof result.data?.points === 'number') {
          this.userPoints = result.data.points;
          return result.data.points;
        }
      } catch (e) {
        console.warn('获取积分余额失败，使用缓存值', e);
      }
      return this.userPoints;
    },

    async buyGalleryView() {
      var isVip = this.canUseVipForGallery;
      var title = isVip ? '会员权益解锁' : '解锁图集列表';
      var price = cfg.viewPrice || 0;
      var content = isVip ? '确认使用会员权益解锁本图集？\n解锁后可无限次查看' : '确认解锁本图集？\n将支付 ' + price + ' 积分';

      if (!isVip) {
        var currentPoints = await this.refreshUserPoints();
        if (currentPoints < price) {
          showPointsGuideModal(currentPoints, price, { skipRefresh: true });
          return;
        }
      }

      var confirmed = await showConfirm(content, {
        title: title,
        type: isVip ? 'vip' : 'unlock',
        confirmText: '立即解锁',
        cancelText: '再想想'
      });
      if (!confirmed) return;

      this.isUnlocking = true;
      try {
        var response = await fetch('/purchase/gallery', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: parseInt(this.galleryId), type: 'gallery_view' })
        });
        var result = await response.json();
        if (result.success) {
          this.isPurchased = true;
          showToast('解锁成功！正在刷新页面...', 'success');
          this.saveScrollPosition();
          setTimeout(function() { location.reload(); }, 1000);
        } else {
          if (result.code === 'INSUFFICIENT_POINTS') {
            showPointsGuideModal(this.userPoints, price);
          } else {
            showToast(result.message || '购买失败', 'error');
          }
        }
      } catch (error) {
        showToast('购买失败，请重试', 'error');
      } finally {
        this.isUnlocking = false;
      }
    },

