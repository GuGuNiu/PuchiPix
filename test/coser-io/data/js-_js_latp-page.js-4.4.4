/**
 * 更多模特组件 - 支持换一批功能
 */
function randomModels() {
  var cfg = window.__latpConfig || {};
  return {
    models: cfg.randomCosers || [],
    loading: false,
    cdnDomain: cfg.cdnDomain || '',

    init() {
      // 初始化完成
    },

    /**
     * 获取图片 URL（处理 CDN 和默认图）
     */
    getImageUrl(coverUrl) {
      if (!coverUrl) return '/assets/static/empty.svg';
      if (coverUrl.startsWith('http')) {
        return this.appendImageClass(coverUrl, 'categorycovermobile');
      }
      if (coverUrl.startsWith('/')) {
        return coverUrl.startsWith('/assets/')
          ? coverUrl
          : this.appendImageClass(coverUrl, 'categorycovermobile');
      }
      if (this.cdnDomain) {
        return this.appendImageClass(
          this.cdnDomain.replace(/\/+$/, '') + '/' + coverUrl,
          'categorycovermobile'
        );
      }
      return this.appendImageClass('/' + coverUrl, 'categorycovermobile');
    },

    appendImageClass(url, imageClass) {
      if (!imageClass || url.indexOf('class=') !== -1) return url;
      return url + (url.indexOf('?') === -1 ? '?' : '&') + 'class=' + imageClass;
    },

    /**
     * 刷新随机模特列表
     */
    async refresh() {
      if (this.loading) return;
      this.loading = true;

      try {
        var response = await fetch('/web-api/v1/random-models/refresh', {
          method: 'POST',
        });
        var result = await response.json();

        if (result.success && result.data) {
          this.models = result.data;
        } else {
          showToast(result.message || '刷新失败', 'error');
        }
      } catch (error) {
        showToast('刷新失败，请重试', 'error');
      } finally {
        this.loading = false;
      }
    }
  };
}

