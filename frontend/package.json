{
  "name": "puchipix-frontend",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "vite preview --host --port 10540",
    "lint": "eslint",
    "test": "echo \"No tests configured\" && exit 0",
    "test:typecheck": "tsc --noEmit",
    "docker:build": "docker build -t puchipix .",
    "docker:run": "docker run -p 10540:10540 puchipix"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.18.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "^7.5.0",
    "react-window": "^2.2.7",
    "sonner": "^2.0.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9",
    "sass": "^1.102.0",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^7",
    "typescript-eslint": "^8.64.0",
    "vite": "^6.3.0"
  }
}
