datasource db {
  provider = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model DownloadTask {
  id        Int        @id @default(autoincrement())
  url       String
  m3u8Url   String     @default("") @map("m3u8_url")
  status    String     @default("pending")
  progress  Float      @default(0)
  filePath  String     @default("") @map("file_path")
  format    String     @default("mp4")
  priority  Int        @default(1)
  errorMsg  String     @default("") @map("error_msg")
  seq       String?    @map("seq")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  videoInfo VideoInfo?

  @@map("download_tasks")
}

model VideoInfo {
  id         Int          @id @default(autoincrement())
  taskId     Int          @unique @map("task_id")
  title      String       @default("")
  sourceUrl  String       @default("") @map("source_url")
  fileSize   BigInt       @default(0) @map("file_size")
  duration   Float        @default(0)
  tags       String       @default("")
  actors     String       @default("")
  categories String       @default("")
  director   String       @default("")
  resolution String       @default("")
  createdAt  DateTime     @default(now()) @map("created_at")
  task       DownloadTask @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("video_infos")
}

model Gallery {
  id                Int                @id @default(autoincrement())
  seq               String?            @map("seq")
  sourceUrl         String             @unique @map("source_url")
  siteId            String             @default("aimeizizi") @map("site_id")
  scrapedDomain     String             @default("") @map("scraped_domain")
  title             String             @default("")
  protagonist       String             @default("")
  description       String             @default("")
  category          String             @default("")
  tags              String             @default("")
  coverUrl          String             @default("") @map("cover_url")
  coverLocalPath    String             @default("") @map("cover_local_path")
  imageCount        Int                @default(0) @map("image_count")
  videoCount        Int                @default(0) @map("video_count")
  pageCount         Int                @default(0) @map("page_count")
  status            String             @default("pending")
  errorMsg          String             @default("") @map("error_msg")
  downloadMethod    String             @default("pending") @map("download_method")
  expectedImageCount Int               @default(0) @map("expected_image_count")
  expectedVideoCount Int               @default(0) @map("expected_video_count")
  contentVerified   Boolean            @default(false) @map("content_verified")
  savePath          String             @default("") @map("save_path")
  totalSize         BigInt             @default(0) @map("total_size")
  downloadedSize    BigInt             @default(0) @map("downloaded_size")
  gameCharacters    String?            @map("game_characters")
  publishTime       String?            @map("publish_time")
  scrapedAt         DateTime?          @map("scraped_at")
  completedAt       DateTime?          @map("completed_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  images            GalleryImage[]
  videos            GalleryVideo[]
  downloadInfo      GalleryDownloadInfo?

  @@index([protagonist])
  @@index([siteId, protagonist])
  @@index([status])
  @@index([category])
  @@index([createdAt])

  @@map("galleries")
}

model GalleryImage {
  id          Int      @id @default(autoincrement())
  galleryId   Int      @map("gallery_id")
  url         String
  localPath   String   @default("") @map("local_path")
  fileName    String   @default("") @map("file_name")
  fileSize    BigInt   @default(0) @map("file_size")
  width       Int      @default(0)
  height      Int      @default(0)
  format      String   @default("")
  pageIndex   Int      @default(0) @map("page_index")
  orderIndex  Int      @default(0) @map("order_index")
  status      String   @default("pending")
  errorMsg    String   @default("") @map("error_msg")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  gallery     Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, orderIndex])
  @@index([galleryId, status])

  @@map("gallery_images")
}

model GalleryVideo {
  id          Int      @id @default(autoincrement())
  galleryId   Int      @map("gallery_id")
  url         String
  localPath   String   @default("") @map("local_path")
  fileName    String   @default("") @map("file_name")
  fileSize    BigInt   @default(0) @map("file_size")
  duration    Float    @default(0)
  resolution  String   @default("")
  format      String   @default("")
  status      String   @default("pending")
  errorMsg    String   @default("") @map("error_msg")
  completedAt DateTime? @map("completed_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  gallery     Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@index([galleryId, status])

  @@map("gallery_videos")
}

model GalleryDownloadInfo {
  id                Int      @id @default(autoincrement())
  galleryId         Int      @unique @map("gallery_id")
  title             String   @default("")
  fileCount         Int      @default(0) @map("file_count")
  fileSizeText      String   @default("") @map("file_size_text")
  imageDimensions   String   @default("") @map("image_dimensions")
  password          String   @default("")
  downloadUrl       String   @default("") @map("download_url")
  downloadSource    String   @default("unknown") @map("download_source")
  ouoUrl            String   @default("") @map("ouo_url")
  resolvedDirectUrl String   @default("") @map("resolved_direct_url")
  provider          String   @default("")
  requiresLogin     Boolean  @default(false) @map("requires_login")
  requiresEmail     Boolean  @default(false) @map("requires_email")
  status            String   @default("available")
  localPath         String   @default("") @map("local_path")
  extractedPath     String   @default("") @map("extracted_path")
  actualSize        BigInt   @default(0) @map("actual_size")
  zipFileName       String   @default("") @map("zip_file_name")
  parallelism       Int      @default(0)
  avgSpeed          Int      @default(0) @map("avg_speed")
  verifiedCount     Int      @default(0) @map("verified_count")
  countMatched      Boolean  @default(false) @map("count_matched")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  gallery           Gallery  @relation(fields: [galleryId], references: [id], onDelete: Cascade)

  @@map("gallery_download_infos")
}

model SniffTask {
  id           Int      @id @default(autoincrement())
  seq          String?  @map("seq")
  url          String
  siteId       String   @default("") @map("site_id")
  status       String   @default("pending")
  totalFound   Int      @default(0) @map("total_found")
  totalCreated Int      @default(0) @map("total_created")
  totalSkipped Int      @default(0) @map("total_skipped")
  errorMsg     String   @default("") @map("error_msg")
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("sniff_tasks")
}

model AppConfig {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String   @default("")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_configs")
}

model SiteAccount {
  id           Int       @id @default(autoincrement())
  siteId       String    @map("site_id")
  username     String
  password     String
  domain       String    @default("")
  status       String    @default("active")
  authCookies  String    @default("") @map("auth_cookies")
  cookiePrefix String    @default("") @map("cookie_prefix")
  lastLoginAt  DateTime? @map("last_login_at")
  lastUsedAt   DateTime? @map("last_used_at")
  failCount    Int       @default(0) @map("fail_count")
  remark       String    @default("")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([siteId, status])
  @@index([domain])

  @@map("site_accounts")
}

model Person {
  id           Int      @id @default(autoincrement())
  name         String   @unique
  pinyin       String   @default("")
  aliases      String   @default("[]") @map("aliases")
  source       String   @default("auto")
  sourceGame   String?  @map("source_game")
  galleryCount Int      @default(0) @map("gallery_count")
  confirmed    Boolean  @default(false)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([pinyin])
  @@index([source])

  @@map("persons")
}

model BlocklistRule {
  id         Int      @id @default(autoincrement())
  siteId     String   @default("all") @map("site_id")
  fieldType  String   @map("field_type")
  keyword    String
  matchMode  String   @default("includes") @map("match_mode")
  enabled    Boolean  @default(true)
  remark     String   @default("")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([siteId, enabled])
  @@index([fieldType])

  @@map("blocklist_rules")
}

model UserPreference {
  id            Int      @id @default(autoincrement())
  key           String   @unique
  value         String   @default("")
  category      String   @default("general") @map("category")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([category])

  @@map("user_preferences")
}

model DagEvent {
  id        Int      @id @default(autoincrement())
  seq       Int      @unique
  dagId     String   @map("dag_id")
  nodeId    String?  @map("node_id")
  type      String
  payload   String
  timestamp DateTime @default(now())

  @@index([dagId])
  @@index([seq])
  @@index([type])

  @@map("dag_events")
}

model DagSnapshot {
  id        Int      @id @default(autoincrement())
  dagId     String   @map("dag_id")
  state     String
  lastSeq   Int      @map("last_seq")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([dagId])
  @@index([createdAt])

  @@map("dag_snapshots")
}