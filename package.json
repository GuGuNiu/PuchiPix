{
  "name": "puchipix-nextjs",
  "version": "0.2.4",
  "private": true,
  "packageManager": "pnpm@10.9.0",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "next build",
    "start": "tsx server.ts",
    "lint": "eslint",
    "test": "echo \"No tests configured\" && exit 0",
    "test:typecheck": "tsc --noEmit",
    "test:pinyin": "tsx tests/manual/pinyin-service-test.ts",
    "test:character-db": "tsx tests/manual/character-db-test.ts",
    "test:pinyin-matcher": "tsx tests/manual/character-db-test-pinyin.ts",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "docker:build": "docker build -t puchipix .",
    "docker:run": "docker run -p 10540:10540 --env-file .env -v puchipix-data:/app/data puchipix",
    "dag": "tsx scripts/dag-cli.ts",
    "dag:status": "tsx scripts/dag-cli.ts status",
    "dag:watch": "tsx scripts/dag-cli.ts watch",
    "dag:logs": "tsx scripts/dag-cli.ts logs",
    "dag:slots": "tsx scripts/dag-cli.ts slots",
    "dag:scheduler": "tsx scripts/dag-cli.ts scheduler"
  },
  "dependencies": {
    "@libsql/client": "^0.17.3",
    "@prisma/adapter-libsql": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@types/react-window": "^2.0.0",
    "adm-zip": "^0.6.0",
    "cheerio": "^1.2.0",
    "lucide-react": "^1.18.0",
    "next": "16.2.10",
    "node-unrar-js": "^2.0.2",
    "pinyin-pro": "^3.28.1",
    "playwright": "^1.60.0",
    "prisma": "^7.8.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-window": "^2.2.7",
    "server-only": "^0.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.64.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  }
}
