# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ============================================================
# 依赖与缓存目录（全部限定在项目内，不提交到 Git）
# ============================================================

# pnpm 包管理器存储和缓存（项目内目录）
/.pnpm-store
/.npm-cache

# Node.js 依赖
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ============================================================
# 运行时数据目录
# ============================================================

# 数据库文件
/data/*.db
/data/*.db-journal

# 下载的视频文件和临时分片
/data/videos/
/data/temp/
/data/playwright-browsers/

# 下载的图包（每个图库一个独立子文件夹）
/data/galleries/
!/data/galleries/.gitkeep

# testing
/coverage

# ============================================================
# Next.js 构建产物
# ============================================================

/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
