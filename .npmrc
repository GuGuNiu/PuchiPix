
# pnpm 全局存储目录（存放硬链接的内容寻址存储），指向项目内的 .pnpm-store
store-dir=./.pnpm-store

# pnpm 缓存目录（下载的 tarball 缓存），指向项目内的 .npm-cache
cache-dir=./.npm-cache

# 禁用 pnpm 的全局 bin 目录，确保所有可执行文件仅安装在项目 node_modules/.bin 中
# 不在系统路径中创建任何链接
global-bin-dir=./node_modules/.bin

# 使用 hoisted node-linker 以获得更好的兼容性（部分工具不识别 pnpm 的符号链接结构）
node-linker=hoisted

# 严格区分 peer dependencies，避免隐式依赖
strict-peer-dependencies=false

# 允许构建脚本执行（Prisma 引擎需要）
enable-pre-post-scripts=true
